<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.bignerdranch.android.myapplication.ui.HomeFragment"
        android:label="홈" />

    <fragment
        android:id="@+id/sheetsFragment"
        android:name="com.bignerdranch.android.myapplication.ui.SheetsFragment"
        android:label="시트" >
        <action
            android:id="@+id/action_sheetsFragment_to_sheetContentFragment"
            app:destination="@id/sheetContentFragment" />
        <action
            android:id="@+id/action_sheetsFragment_to_sheetDetailFragment"
            app:destination="@id/sheetDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/catalogFragment"
        android:name="com.bignerdranch.android.myapplication.ui.catalog.CatalogFragment"
        android:label="카탈로그" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.bignerdranch.android.myapplication.ui.SettingsFragment"
        android:label="설정" />

    <fragment
        android:id="@+id/countryHistoryFragment"
        android:name="com.bignerdranch.android.myapplication.ui.catalog.CountryHistoryFragment"
        android:label="나라별 저장 내역">
        <argument
            android:name="country"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/sheetContentFragment"
        android:name="com.bignerdranch.android.myapplication.ui.SheetCountriesFragment"
        android:label="나라 선택">
        <argument
            android:name="sheetId"
            app:argType="long" />
        <argument
            android:name="title"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/sheetDetailFragment"
        android:name="com.bignerdranch.android.myapplication.ui.SheetDetailFragment"
        android:label="시트 상세">
        <argument
            android:name="sheetId"
            app:argType="long" />
        <argument
            android:name="title"
            app:argType="string" />
        <argument
            android:name="country"
            app:argType="string"
            app:nullable="true"/>
    </fragment>


    <fragment
        android:id="@+id/historyDetailFragment"
        android:name="com.bignerdranch.android.myapplication.ui.history.HistoryDetailFragment"
        android:label="저장 상세">
        <argument
            android:name="sessionId"
            app:argType="long" />
    </fragment>
</navigation>