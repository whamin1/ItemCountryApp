<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardUseCompatPadding="true"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvSummaryDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="총 26일"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvSummaryKgTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="총 무게: 0.00 kg" />

        <TextView
            android:id="@+id/tvSummaryKgItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="아이템: 0.00 kg" />

        <TextView
            android:id="@+id/tvSummaryKgWaste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="쓰레기: 0.00 kg" />

        <TextView
            android:id="@+id/tvSummaryPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="총 가격: 0"
            android:textStyle="bold"
            android:paddingTop="6dp"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>