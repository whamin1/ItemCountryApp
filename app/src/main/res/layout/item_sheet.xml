<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:padding="12dp"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="16sp"/>

    <Button android:id="@+id/btnApply" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="적용"/>

    <Button android:id="@+id/btnToggle" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="비활성화" android:layout_marginStart="8dp"/>

    <Button android:id="@+id/btnDelete" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="삭제" android:layout_marginStart="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/llPreview"
        android:orientation="vertical"
        android:paddingTop="8dp">
    </LinearLayout>
</LinearLayout>