<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/dialog_edit_line_simple.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="12dp"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <EditText
        android:id="@+id/etItem"
        android:hint="아이템명"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etNeeded"
        android:hint="필요 수량" android:inputType="number"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etWeight"
        android:hint="무게(예: 1.2)" android:inputType="numberDecimal"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etPrice"
        android:hint="가격" android:inputType="number"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>